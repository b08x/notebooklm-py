# NotebookLM Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Configuration Environment Variables
# =============================================================================

# Custom home directory for all config files (optional)
# Default: ~/.notebooklm
# NOTEBOOKLM_HOME=/custom/path

# Inline authentication JSON for CI/CD (optional)
# When set, authentication is read from this variable instead of a file
# Get the value from: cat $NOTEBOOKLM_HOME/storage_state.json (default: ~/.notebooklm)
# NOTEBOOKLM_AUTH_JSON='{"cookies":[...]}'

# Enable RPC debug logging (optional)
# NOTEBOOKLM_DEBUG_RPC=1

# =============================================================================
# E2E Testing Configuration
# =============================================================================

# Required for E2E tests: Your READ-ONLY test notebook ID
# Create a notebook at https://notebooklm.google.com with:
#   - Multiple sources (text, URL, PDF, etc.)
#   - Some pre-generated artifacts (audio, quiz, etc.)
# Copy the notebook ID from the URL: notebooklm.google.com/notebook/YOUR_ID
# This notebook is used for READ-ONLY tests (list, get, download operations)
NOTEBOOKLM_READ_ONLY_NOTEBOOK_ID=your-notebook-id-here

# Optional: Generation test notebook ID
# If not set, a notebook will be auto-created and its ID stored in
# NOTEBOOKLM_HOME/generation_notebook_id for reuse across test runs.
# NOTEBOOKLM_GENERATION_NOTEBOOK_ID=your-generation-notebook-id

# =============================================================================
# Assessment LLM (DSPy) — SFL pass 2, SIFT fact-checks, corpus agent, compiler
# =============================================================================

# Provider for every DSPy completion. One of:
#   openrouter (default) | ollama | any litellm provider prefix
#   claude | agy | vibe | opencode  -> run each completion on that LLM CLI
#                                      coding agent (binary must be on PATH;
#                                      check with `notebooklm doctor`)
# NOTEBOOKLM_ASSESSMENT_MODEL_PROVIDER=openrouter

# Model name. For HTTP providers: default deepseek/deepseek-v4-flash-0731.
# For a CLI agent: passed as the agent's model flag; leave unset to use the
# agent's own default (vibe has no model flag and ignores it).
# NOTEBOOKLM_ASSESSMENT_MODEL=deepseek/deepseek-v4-flash-0731

# Per-completion timeout in seconds when the provider is a CLI agent (default 300)
# NOTEBOOKLM_ASSESSMENT_AGENT_TIMEOUT=300
# (claude uses the subscription login here too; see NOTEBOOKLM_CLAUDE_USE_API_KEY)

# Named agent the CLI loads for assessment completions (`--agent NAME`);
# default notebooklm-assessment, empty = the CLI's default agent.
# NOTEBOOKLM_ASSESSMENT_AGENT_PROFILE=notebooklm-assessment

# Required when NOTEBOOKLM_ASSESSMENT_MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# Embeddings for DSPy (default: ollama / nomic-embed-text)
# NOTEBOOKLM_ASSESSMENT_EMBED_PROVIDER=ollama
# NOTEBOOKLM_ASSESSMENT_EMBED_MODEL=nomic-embed-text

# =============================================================================
# SFL Tagging Backend (`notebooklm corpus tag-sfl`, TUI sfl_tag, Corpus Explorer)
# =============================================================================

# dspy (default; uses the assessment LLM above) | claude | agy | vibe | opencode
# An agent backend runs spaCy pass 1 locally and sends each parent chunk's
# clauses to the agent in one prompt for mood / modality / tenor.
# NOTEBOOKLM_SFL_BACKEND=dspy

# Model flag passed to the SFL agent (unset = agent default)
# NOTEBOOKLM_SFL_AGENT_MODEL=

# Per-invocation timeout in seconds (default 300)
# NOTEBOOKLM_SFL_AGENT_TIMEOUT=300

# 1 = one prompt per parent chunk (default); 0 = one prompt per clause
# NOTEBOOKLM_SFL_AGENT_BATCH=1

# 1 = clauses the agent fails on go to the DSPy engine (default); 0 = record failure
# NOTEBOOKLM_SFL_AGENT_FALLBACK=1

# Named agent each CLI loads (`--agent NAME`); default sfl-annotator, empty = none.
# Definitions: ~/.claude/agents, ~/.gemini/antigravity/agents (agy),
# ~/.vibe/agents, ~/.config/opencode/agents.
# NOTEBOOKLM_SFL_AGENT_PROFILE=sfl-annotator

# Optional: directory opencode (--dir) and vibe (--workdir) run in. Only needed
# for an agent defined in a project-local .opencode/ or .vibe/ folder.
# NOTEBOOKLM_SFL_AGENT_WORKDIR=

# claude: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN are removed from the claude
# child process so it uses your claude.ai subscription login, not per-token API
# billing. Set to 1 to keep them (bill the API key instead).
# NOTEBOOKLM_CLAUDE_USE_API_KEY=0

# =============================================================================
# Corpus Storage and Jobs
# =============================================================================

# Postgres (pgvector) corpus database
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/notebooklm

# Redis job store for the TUI job runner
# NOTEBOOKLM_REDIS_URL=redis://localhost:6379/0
# NOTEBOOKLM_TUI_JOB_WORKERS=

# =============================================================================
# Ingest Embeddings (Ollama)
# =============================================================================

# OLLAMA_URL=http://tinybot:11434
# EMBEDDING_MODEL=embeddinggemma:latest
# OLLAMA_EMBED_TIMEOUT=120.0

# =============================================================================
# Audio Transcription
# =============================================================================

# Provider: deepgram (default) | assemblyai | speechmatics | transcribe_cpp
# NOTEBOOKLM_TRANSCRIBE_PROVIDER=deepgram
# NOTEBOOKLM_TRANSCRIBE_DIARIZE=true
# NOTEBOOKLM_TRANSCRIBE_LANGUAGE=auto
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# SPEECHMATICS_API_KEY=
# Local transcribe_cpp provider
# NOTEBOOKLM_TRANSCRIBE_CPP_MODEL=/path/to/model.bin
# NOTEBOOKLM_TRANSCRIBE_CPP_BIN=main

# =============================================================================
# Tracing (Langfuse) — enabled when both keys are set
# =============================================================================

# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://tinybot:3000
